{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "숏츠 - 단어",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/studio/runner.py",
      "args": [
        "--studio",
        "shorts",
        "--mode",
        "debug",
        "--topic",
        "fruit_store",
        "--shorts-type",
        "vocabulary"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "justMyCode": true
    },
    {
      "name": "배치 (영상 제작)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["batch"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "justMyCode": true
    }
  ]
}
